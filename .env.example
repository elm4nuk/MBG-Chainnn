# Alamat RPC. Kosongkan untuk jaringan lokal "npm run chain" (http://127.0.0.1:8545).
# Ganache GUI biasanya di http://127.0.0.1:7545
RPC_URL=

# Port aplikasi Vite untuk demo:start (default 5173).
APP_PORT=5173

# Opsional HTTPS lokal. Jangan commit kunci atau sertifikat.
# MBG_HTTPS=1
# HTTPS_KEY=/path/ke/mbg-chain-key.pem
# HTTPS_CERT=/path/ke/mbg-chain-cert.pem

# Hanya untuk deploy ke testnet (mis. Sepolia). Pakai akun uji, jangan pernah commit kunci asli.
PRIVATE_KEY=
